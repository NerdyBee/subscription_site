# MySQL connection. On cPanel the database and user names get your account prefix, e.g.
# mysql://cpuser_netportal:PASSWORD@localhost:3306/cpuser_netportal
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/netportal"

NODE_ENV=production
TZ=Africa/Lagos

# Two different long random strings (32+ characters each).
JWT_ACCESS_SECRET="generate-a-long-random-string"
JWT_REFRESH_SECRET="generate-another-long-random-string"

# First super admin, created on first start while no super admin exists.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Secret for the cron URL: https://your-site/api/cron?key=THIS_VALUE
CRON_SECRET="generate-a-third-random-string"

# Only needed for local development (the site and API run on different ports).
# CLIENT_ORIGIN="http://localhost:5173"
# PORT=4000
