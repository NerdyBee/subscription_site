{
  "name": "netportal",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix client install --include=dev",
    "dev": "concurrently -n api,web -c blue,green \"php -S 127.0.0.1:8787 api/index.php\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "node scripts/lint-php.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
